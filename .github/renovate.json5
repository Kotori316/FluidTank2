{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Kotori316/common-script:renovate-default",
    ":rebaseStalePrs",
  ],
  "baseBranches": [
    "$default",
    "26.1",
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gradle"
      ],
      "matchPackagePatterns": [
        "^mezz.jei:*",
        "^appeng:appliedenergistics2-*"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchPackagePatterns": [
        "^com.kotori316:test_utility",
        "^com.kotori316:test_utility_dependency"
      ],
      "enabled": false
    }
  ]
}
